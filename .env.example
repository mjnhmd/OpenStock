# ---- Core ----
NODE_ENV=development

# ---- Database ----
# Local Homebrew MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/openstock
# Docker Compose MongoDB (use this instead when running via docker compose)
# MONGODB_URI=mongodb://root:example@mongodb:27017/openstock?authSource=admin

# ---- Better Auth ----
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_a_random_secret
BETTER_AUTH_URL=http://localhost:3000

# ---- Finnhub (US / global markets) ----
NEXT_PUBLIC_FINNHUB_API_KEY=replace_with_your_finnhub_key
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# ---- A-share market data ----
# Enables the unofficial A-share providers (Eastmoney / Tencent / Sina) plus an
# optional local astock (BaoStock) fallback.
#
# IMPORTANT: those public endpoints are undocumented, carry no SLA and grant no
# redistribution rights. They are intended for local/personal use only.
# Set to "false" before any public deployment.
ENABLE_UNOFFICIAL_MARKET_DATA=true

# Optional final fallback for historical EOD data (BaoStock based).
# Leave empty to disable. Example: /Users/you/bin/astock
ASTOCK_BIN=

# ---- Optional: sentiment insights ----
# ADANOS_API_KEY=
# ADANOS_API_BASE_URL=https://api.adanos.org

# ---- Optional: AI provider for emails (default: gemini) ----
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# MINIMAX_API_KEY=
# SIRAY_API_KEY=

# ---- Optional: Inngest (required for Vercel deployment) ----
# INNGEST_SIGNING_KEY=

# ---- Optional: email (Gmail transport) ----
# NODEMAILER_EMAIL=
# NODEMAILER_PASSWORD=
